# Authentication Configuration
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
SESSION_SECRET=change-this-secret-key-in-production
SESSION_EXPIRY=86400

# AI/LLM Configuration
# For OpenAI-compatible APIs (OpenAI, Azure OpenAI, vLLM, Ollama, etc.)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o
AI_TIMEOUT=300
AI_MAX_RETRIES=3

# Metadata API Configuration
# Get your API keys from:
# - TMDb: https://www.themoviedb.org/settings/api
# - OMDb: http://www.omdbapi.com/apikey.aspx
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here
METADATA_API_TIMEOUT=30

# Scheduling Configuration (in seconds)
SCAN_INTERVAL=3600          # Media scanning interval (1 hour)
CLEANUP_INTERVAL=3600       # Cleanup task interval (1 hour)
WORKER_POLL_INTERVAL=30     # Worker polling interval (30 seconds)
TASK_TIMEOUT=7200           # Maximum task processing time (2 hours)

# Processing Configuration
MAX_FAILURE_COUNT=3                 # Maximum retry attempts before giving up
MAX_CONCURRENT_WORKERS=2            # Number of parallel worker processes
AUDIO_SEGMENT_DURATION=300          # Audio chunk length in seconds (5 minutes)
AUDIO_OVERLAP_DURATION=10           # Overlap between chunks in seconds
SCREENSHOTS_PER_SEGMENT=10          # Screenshots per audio segment
TARGET_SUBTITLE_LANGUAGE=en         # ISO language code (en, zh, etc.)
TEMP_CLEANUP_ENABLED=true           # Auto-cleanup temporary files
TEMP_RETENTION_HOURS=24             # Hours to retain temp files for debugging

# Network Configuration (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
